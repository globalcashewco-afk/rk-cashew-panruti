{
  "name": "rk-cashew-panruti",
  "main": "worker-entry.js",
  "compatibility_date": "2025-09-01",
  "assets": { "directory": "./public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page", "run_worker_first": ["/*"] },
  "kv_namespaces": [ { "binding": "KV" } ],
  "ai": { "binding": "AI" },
  "previews": {
    "ai": {
      "binding": "AI"
    }
  }
}
